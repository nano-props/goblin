{
  "name": "goblin",
  "productName": "Goblin",
  "version": "0.3.4",
  "description": "Goblin — Workspace Manager",
  "private": true,
  "type": "module",
  "main": "src/main/main.ts",
  "imports": {
    "#/*": "./src/*",
    "#scripts/*": "./scripts/*"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun run build:web && bun scripts/start-electron.ts",
    "build": "bun scripts/build.ts",
    "build:preload": "bun scripts/build-preload.ts",
    "build:web": "vite build",
    "build:server": "bun scripts/build-server.ts",
    "build:standalone-server": "bun scripts/build-standalone-server.ts",
    "start:server": "node scripts/start-server.ts",
    "reset-token": "bun scripts/reset-token.ts",
    "build:electron": "electron-builder",
    "install:app": "bun install.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:no-html-injection": "bun scripts/check-no-html-injection.ts",
    "check:type-assertions": "bun scripts/check-type-assertions.ts",
    "check:inline-type-imports": "bun scripts/check-inline-type-imports.ts",
    "check": "bun run typecheck && bun run format:check",
    "typecheck": "bun scripts/typecheck.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish": "bun scripts/publish.ts",
    "count-lines": "bun scripts/count-lines.ts",
    "clean": "rm -rf dist release"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@babel/traverse": "8.0.4",
    "@babel/types": "8.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-query-devtools": "6.1.38",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.3",
    "@testing-library/vue": "8.1.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-component-type-helpers": "3.3.9"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/vue": "0.5.0",
    "@hono/node-server": "2.1.0",
    "@lucide/vue": "1.31.0",
    "@tanstack/query-core": "5.101.4",
    "@tanstack/vue-query": "5.101.4",
    "@tanstack/vue-virtual": "3.13.35",
    "@vueuse/core": "14.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-progress": "0.2.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "consola": "3.4.2",
    "croner": "10.0.1",
    "date-fns": "4.4.0",
    "es-toolkit": "1.50.0",
    "execa": "10.0.1",
    "hono": "4.13.1",
    "immer": "11.1.16",
    "nanoid": "6.0.1",
    "node-pty": "1.1.0",
    "p-queue": "9.3.3",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "reka-ui": "2.10.1",
    "smol-toml": "1.7.1",
    "tailwind-merge": "3.6.0",
    "tinyglobby": "0.2.17",
    "valibot": "1.4.2",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "vue-sonner": "2.0.9",
    "write-file-atomic": "8.0.0",
    "ws": "8.21.3",
    "zustand": "5.0.14"
  }
}
