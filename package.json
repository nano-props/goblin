{
  "name": "goblin",
  "version": "0.4.1",
  "description": "Goblin — Workspace Manager",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#scripts/*": "./scripts/*"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun run build && ./dist/goblin serve",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun scripts/build-server.ts",
    "start:server": "bun src/server/main.ts serve",
    "reset-token": "bun scripts/reset-token.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:no-html-injection": "bun scripts/check-no-html-injection.ts",
    "check:type-assertions": "bun scripts/check-type-assertions.ts",
    "check:inline-type-imports": "bun scripts/check-inline-type-imports.ts",
    "check": "bun run typecheck && bun run format:check",
    "typecheck": "bun scripts/typecheck.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "count-lines": "bun scripts/count-lines.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "@babel/types": "8.0.6",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-query-devtools": "6.3.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/vue": "8.1.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-component-type-helpers": "3.3.13"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/vue": "0.5.0",
    "@hono/node-server": "2.1.4",
    "@lucide/vue": "1.55.0",
    "@tanstack/query-core": "5.104.2",
    "@tanstack/vue-query": "5.104.2",
    "@tanstack/vue-virtual": "3.13.41",
    "@vueuse/core": "15.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-progress": "0.2.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "consola": "3.4.2",
    "croner": "10.0.1",
    "date-fns": "4.4.0",
    "es-toolkit": "1.52.0",
    "execa": "10.1.0",
    "hono": "4.13.13",
    "immer": "11.1.21",
    "nanoid": "6.0.2",
    "p-queue": "9.3.5",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "reka-ui": "2.11.0",
    "smol-toml": "1.9.1",
    "string-width": "8.3.0",
    "tailwind-merge": "3.7.0",
    "tinyglobby": "0.2.17",
    "valibot": "1.5.0",
    "vue": "3.5.43",
    "vue-i18n": "11.4.14",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9",
    "write-file-atomic": "8.0.0",
    "ws": "8.22.0",
    "zustand": "5.0.15"
  }
}
